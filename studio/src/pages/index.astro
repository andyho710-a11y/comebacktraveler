---
import StudioLayout from '../layouts/StudioLayout.astro';
const faqs = [
  ['可以在目的地等候，再載我們回來嗎？', '可以提出原車等候需求。請提供預計停留時間，駕駛會依檔期、總工時與車隊規範人工確認；提出需求不代表已接受預約。'],
  ['可以安排多個停靠點嗎？', '可以先告知停靠地區、順序及每站預計時間，再確認路線、工時與依法計價條件。'],
  ['多久以前預約？如何確認預約成功？', '建議行程確定後提早詢問。填表或傳送 LINE 都只是詢問，須經人工聯繫、依法報價並完成車隊規定的正式預約程序才成立。'],
  ['可以搭幾位乘客、放幾件行李？', '車主提供的車型為 Toyota Corolla Cross Hybrid 油電車，5 人座包含駕駛，原則最多 4 位乘客，仍以行照、安全座椅及實際配置核對。年份、等級與行李容量尚待確認；請先提供行李尺寸再安排。'],
  ['可以從高雄到台南、屏東或嘉義嗎？', '這些是可提出詢問的路線。是否承接須確認實際營業區域、接送規定、行程與檔期，並非保證所有路線都能服務。'],
  ['長輩外出包含陪診或無障礙服務嗎？', '目前規劃一般乘車接送與等候，不提供醫療照護、長照特約、專業陪診或無障礙車輛服務。若需特殊協助，請洽具對應資格的單位。'],
  ['取消、改期或需要付款時怎麼辦？', '請儘早聯繫。具體取消、改期、費用與付款方式，於正式預約前依車隊規定說明並確認；本網站不收款、不收訂金。'],
];
---
<StudioLayout title="高雄安心長途接送｜長輩外出、跨縣市往返與半日包車" description="從楠梓、左營、橋頭、岡山出發，詢問長途接送、長輩外出等候往返與半日包車。先聊需求，再人工確認路線與合法預約方式。">
  <main id="main">
    <section class="hero wrap">
      <div class="hero-copy"><p class="eyebrow"><span></span> 從高雄出發，把行程安排得更安心</p><h1>出門有人接，<br />回程也<span class="underline">有人等。</span></h1><p class="hero-description">替父母安排一趟外出，或是全家久違的返鄉。<br class="desktop" />長一點的路，先說好時間，也留好回程。</p><div class="hero-actions"><a class="button" href="#inquiry">LINE 詢問行程 <span aria-hidden="true">↗</span></a><a class="text-link" href="#services">看看適合的服務 <span aria-hidden="true">↓</span></a></div><p class="subtle">提前詢問 · 人工確認 · 依規定完成正式預約</p><div class="hero-tags"><span>長輩外出</span><span>跨縣市往返</span><span>半日包車</span></div></div>
      <div class="journey-art" role="img" aria-label="從家出發，經過城市與山景，再安心返回的路線插畫；不是實際車輛照片">
        <div class="art-top"><span class="eyebrow">A LITTLE FURTHER. A LITTLE EASIER.</span><span class="art-number">01 — 03</span></div>
        <svg viewBox="0 0 600 470" aria-hidden="true"><defs><linearGradient id="sky" x2="0" y2="1"><stop stop-color="#dce7df"/><stop offset="1" stop-color="#f0eee4"/></linearGradient></defs><rect width="600" height="470" fill="url(#sky)"/><circle cx="447" cy="105" r="43" fill="#e5b974"/><path d="M0 282 105 173 219 280 346 147 600 290V470H0" fill="#b6c9bc"/><path d="M0 322 143 250 281 338 465 228 600 304V470H0" fill="#8fae9b"/><path d="M0 389Q153 311 307 361T600 366V470H0" fill="#668b74"/><path d="M-20 461Q147 323 281 394T635 301" fill="none" stroke="#e8dfca" stroke-width="65"/><path d="M-20 461Q147 323 281 394T635 301" fill="none" stroke="#fff9ec" stroke-width="2" stroke-dasharray="14 14"/><g transform="translate(218 312)"><path d="M6 46 24 11Q27 5 38 5H95Q106 5 111 16L130 46Z" fill="#f9f6ec"/><rect x="0" y="39" width="140" height="44" rx="14" fill="#faf8ef"/><path d="M32 14H92L105 39H22Z" fill="#426658"/><path d="M63 14V39" stroke="#f9f6ec" stroke-width="5"/><circle cx="30" cy="81" r="14" fill="#253d32"/><circle cx="111" cy="81" r="14" fill="#253d32"/><circle cx="30" cy="81" r="6" fill="#d6cfbb"/><circle cx="111" cy="81" r="6" fill="#d6cfbb"/><rect x="127" y="51" width="10" height="10" rx="3" fill="#e5b974"/></g><g transform="translate(80 265)"><path d="m0 28 33-28 33 28v53H0Z" fill="#f7f2e7"/><path d="m-8 32 41-34 41 34" fill="none" stroke="#c4916a" stroke-width="8"/><rect x="25" y="48" width="17" height="33" fill="#698370"/></g><path d="M489 328v-59" stroke="#3c6850" stroke-width="7"/><path d="m489 214-30 65h60Z" fill="#3d7253"/><path d="M521 345v-42" stroke="#3c6850" stroke-width="6"/><path d="m521 260-24 53h48Z" fill="#4b7d5b"/></svg>
        <div class="route-card"><span class="route-dot"></span><div><small>從熟悉的家出發</small><strong>到想去的地方，再安心回家</strong></div><span class="route-arrow" aria-hidden="true">↗</span></div><p class="art-caption">行程示意插畫 · 非實際車型或服務承諾</p>
      </div>
    </section>
    <div class="promise-band"><div class="wrap promises"><span><b>01</b> 提前安排，不趕行程</span><span><b>02</b> 一對一討論需求</span><span><b>03</b> 接送與等候一起確認</span></div></div>
    <section id="services" class="wrap section"><div class="section-heading"><div><p class="eyebrow">FOR THE JOURNEYS THAT MATTER</p><h2>不只是一段路，<br />是一次放心的安排。</h2></div><p>從單程出發到原車等候，<br />依照你的行程，一起確認合適的方式。</p></div><div class="service-grid">
      <article class="service-card"><div class="card-top"><span class="service-icon" aria-hidden="true">↗</span><small>01 / ONE WAY</small></div><h3>跨縣市單程接送</h3><p>返鄉探親、家庭聚會、異地辦事，提前安排一趟長途行程。</p><span class="card-note">適合有明確目的地的你</span></article>
      <article class="service-card featured"><div class="card-top"><span class="service-icon" aria-hidden="true">↔</span><small>02 / ROUND TRIP</small></div><h3>長輩外出・等候往返</h3><p>替父母安排交通，先討論上下車與停留時間，回程也一起安排。</p><span class="card-note">一般乘車接送，非照護或陪診服務</span></article>
      <article class="service-card"><div class="card-top"><span class="service-icon" aria-hidden="true">☀</span><small>03 / AT YOUR PACE</small></div><h3>半日／一日包車</h3><p>家庭出遊、跨點辦事或商務行程，一起規劃停靠點與用車時數。</p><span class="card-note">依合法運價及車隊規範確認</span></article>
    </div></section>
    <section class="area-section"><div class="wrap area-grid"><div><p class="eyebrow">ROOTED IN KAOHSIUNG</p><h2>熟悉高雄，<br />陪你往遠一點的地方。</h2><p>優先討論的出發地區</p><div class="area-tags"><span>楠梓</span><span>左營</span><span>橋頭</span><span>岡山</span></div><p>台南、屏東、嘉義等跨縣市路線，可先提供需求。<br />依實際營業區域、接送規定及檔期確認承接。</p></div><aside class="note-card"><span class="eyebrow">先認識，再安心出發</span><h3>真實資訊，確認後才公開。</h3><p>經營者自述有 Uber、Yoxi、55688 駕駛經驗；資格與服務細節仍待正式核對。</p><dl><div><dt>Toyota Corolla Cross Hybrid</dt><dd>車主提供</dd></div><div><dt>5 人座含駕駛／行李空間</dt><dd>配置待核對</dd></div><div><dt>實車照片／合法執業資訊</dt><dd>待提供</dd></div><div><dt>保險範圍／車隊預約方式</dt><dd>待核對</dd></div></dl></aside></div></section>
    <section id="process" class="wrap section"><p class="eyebrow">A SIMPLE WAY TO PLAN</p><h2>把需求說清楚，安排就簡單。</h2><ol class="steps"><li><span>01</span><h3>告訴我行程</h3><p>填寫需求，或整理成 LINE 訊息。</p></li><li><span>02</span><h3>人工確認</h3><p>確認路線、檔期、車型與等候需求。</p></li><li><span>03</span><h3>依法報價與預約</h3><p>依車隊規範說明費用並完成正式程序。</p></li><li><span>04</span><h3>依約完成接送</h3><p>出發前再次確認時間與集合方式。</p></li></ol><p class="callout">填寫表單或傳送訊息只代表行程詢問，不會自動成立預約、報價或付款。</p></section>
    <section id="inquiry" class="inquiry-section"><div class="wrap inquiry-grid"><div class="inquiry-intro"><p class="eyebrow">LET'S PLAN YOUR JOURNEY</p><h2>這趟路，<br />你想怎麼安排？</h2><p>先提供地區即可，不需要完整門牌。<br />請勿填寫身分證、病歷或其他敏感資料。</p><div class="contact-panel"><h3>習慣直接用 LINE 聊？</h3><p id="line-status">官方帳號待設定。可先產生詢問文字，再自行複製。</p><a id="line-link" class="button" hidden rel="noreferrer" target="_blank">加入官方 LINE ↗</a><a id="phone-link" hidden>電話聯繫</a></div><p class="subtle">實際車型、車隊流程與服務資料確認前，這裡僅供測試。請勿送出真實個資。</p></div>
      <form id="inquiry-form" class="form-card"><div class="form-heading"><h3>行程詢問</h3><span>約 2 分鐘填寫</span></div><p>＊為必填。此表單不是正式預約。</p>
        <fieldset><legend>01 行程安排</legend><div class="form-grid"><label>用車日期＊<input name="date" type="date" required /></label><label>預計出發時間＊<input name="time" type="time" required /></label><label>上車地區＊<input name="pickup" maxlength="100" autocomplete="off" placeholder="例如：高雄楠梓區" required /></label><label>目的地＊<input name="destination" maxlength="100" autocomplete="off" placeholder="填寫縣市、地區或地標" required /></label><label>單程或來回＊<select name="trip"><option value="oneway">單程</option><option value="return">來回</option></select></label><label>預計等候（小時）<input name="waitHours" type="number" min="0" max="24" step="0.5" value="0" required /></label><label class="full">其他停靠點<input name="stops" maxlength="300" placeholder="選填：停靠地區與預計停留時間" /></label></div></fieldset>
        <fieldset><legend>02 乘車需求</legend><div class="form-grid"><label>乘客人數＊<input name="passengers" type="number" min="1" max="9" value="1" required /></label><label>行李件數＊<input name="bags" type="number" min="0" max="20" value="0" required /></label></div><p class="field-note">人數欄位供需求蒐集，非保證載客容量。超出實際車型的需求須另行討論。</p></fieldset>
        <fieldset><legend>03 聯絡方式</legend><div class="form-grid"><label>聯絡稱呼＊<input name="name" maxlength="40" autocomplete="off" required placeholder="方便聯繫的稱呼即可" /></label><label>LINE 或電話＊<input name="contact" maxlength="80" autocomplete="off" required placeholder="提供一種即可" /></label><label class="full">其他需求<textarea name="notes" maxlength="500" rows="3" placeholder="選填，請避免填寫健康或其他敏感資料"></textarea></label></div></fieldset>
        <div class="honeypot" aria-hidden="true"><label>請保留空白<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="check"><input name="consent" type="checkbox" required /><span>我已閱讀<a href="/privacy" target="_blank" rel="noreferrer">個資蒐集告知</a>，同意僅供行程詢問與聯繫使用，並了解須人工確認及完成合法預約程序。＊</span></label>
        <p id="privacy-contact" class="field-note">資料管理者及聯絡窗口待確認；本機測試資料最多保留 30 天。</p><div class="form-actions"><button type="submit" class="button" id="submit-inquiry" disabled>收單尚未啟用</button><button type="button" class="button secondary" id="make-text">產生 LINE 詢問文字</button></div><p role="status" aria-live="polite" id="form-status"></p><div id="message-box" hidden><label>請確認內容，再自行複製到 LINE<textarea id="message-text" rows="10" readonly></textarea></label><button id="copy-text" type="button" class="button secondary">複製詢問文字</button><p class="field-note">文字只在目前頁面產生；不放進網址、不自動傳給 LINE。</p></div>
      </form></div></section>
    <section id="faq" class="wrap section faq-section"><div><p class="eyebrow">BEFORE WE SET OFF</p><h2>出發前，<br />你可能想知道。</h2></div><div class="faq-list">{faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
    <section class="wrap closing"><span class="eyebrow">每一趟重要的行程，都值得提前安排。</span><h2>下次出門，先把回程也安排好。</h2><a class="button" href="#inquiry">一起聊聊這趟行程 ↗</a></section>
  </main>
  <div class="mobile-cta"><span>先聊需求，再確認預約</span><a href="#inquiry" class="button small">LINE 詢問行程 ↗</a></div>
  <script>import '../scripts/inquiry.mjs';</script>
</StudioLayout>
