<script is:inline>
  (function () {
    if (window.__cbtAffiliateClickTracker) return;
    window.__cbtAffiliateClickTracker = true;

    var affiliateSelector = [
      'a[rel~="sponsored"]',
      'a[href*="coupa.ng"]',
      'a[href*="collshp.com"]',
      'a[href*="s.shopee.tw"]',
      'a[href*="afflink.one"]',
      'a[href*="onelink.one"]',
      'a[href*="linkgo.one"]',
      'a[href*="s.momoshop.com.tw"]',
      'a[href*="amazon.com"]',
      'a[href*="amzn.to"]',
      'a[data-affiliate]'
    ].join(',');

    function getAffiliateDomain(href) {
      try {
        return new URL(href, window.location.href).hostname;
      } catch (error) {
        return '';
      }
    }

    function isDomain(hostname, domain) {
      return hostname === domain || hostname.endsWith('.' + domain);
    }

    function getAffiliateNetwork(link, href) {
      var explicit = getTrackingValue(link, 'data-affiliate');
      if (['coupang', 'shopee', 'momo', 'affiliates_one', 'amazon'].includes(explicit)) return explicit;

      var hostname = getAffiliateDomain(href);
      if (!hostname) return 'unknown';

      if (isDomain(hostname, 'coupa.ng')) return 'coupang';
      if (isDomain(hostname, 'collshp.com') || isDomain(hostname, 'shopee.tw')) return 'shopee';
      if (isDomain(hostname, 'momoshop.com.tw')) return 'momo';
      if (['afflink.one', 'onelink.one', 'linkgo.one'].some(function (domain) { return isDomain(hostname, domain); })) return 'affiliates_one';
      if (isDomain(hostname, 'amazon.com') || isDomain(hostname, 'amzn.to')) return 'amazon';
      return 'affiliate';
    }

    function getMerchant(link, href) {
      var explicit = getTrackingValue(link, 'data-affiliate-merchant');
      if (['coupang', 'shopee', 'momo', 'joytel', 'klook', 'kkday', 'trip_com', 'booking_com', 'amazon'].includes(explicit)) return explicit;
      var hostname = getAffiliateDomain(href);
      if (isDomain(hostname, 'coupa.ng') || isDomain(hostname, 'coupang.com')) return 'coupang';
      if (isDomain(hostname, 'collshp.com') || isDomain(hostname, 'shopee.tw')) return 'shopee';
      if (isDomain(hostname, 'momoshop.com.tw')) return 'momo';
      // A short-link network does not establish which merchant it leads to.
      return 'unknown';
    }

    function getTrackingValue(link, attribute) {
      return (link.getAttribute(attribute) || '').trim().slice(0, 120);
    }

    function getMachineValue(link, attribute, fallback) {
      var value = getTrackingValue(link, attribute);
      return /^[a-z][a-z0-9_-]{0,79}$/i.test(value) ? value : fallback;
    }

    function getProductName(link) {
      // Editorial metadata only: never read button labels, form values or search text.
      var value = getTrackingValue(link, 'data-affiliate-product');
      return value && !/[@\r\n]|https?:|\d{7,}/i.test(value) ? value : 'unspecified';
    }

    function getPagePath(path) {
      return /^\/(?:[a-z0-9-]+\/?)*$/.test(path) && !/\d{7,}/.test(path) ? path : '/';
    }

    function getAnalyticsUrl(href, keepShortPath) {
      try {
        var url = new URL(href, window.location.href);
        if (!['https:', 'http:'].includes(url.protocol)) return '';
        var host = url.hostname;
        var shortPath = /^\/s\/[a-z0-9]{1,32}$/i.test(url.pathname) &&
          ['afflink.one', 'onelink.one', 'linkgo.one', 's.momoshop.com.tw'].includes(host);
        var codePath = /^\/[a-z0-9]{1,32}$/i.test(url.pathname) && /[a-z]/i.test(url.pathname) &&
          ['coupa.ng', 's.shopee.tw', 'amzn.to'].includes(host);
        // Strip ALL query/hash/userinfo. Unknown or session-bearing paths become origin only.
        return url.origin + (keepShortPath && (shortPath || codePath) ? url.pathname : '');
      } catch (error) {
        return '';
      }
    }

    function getCtaPosition(link) {
      var explicit = getMachineValue(link, 'data-cta-position', '');
      if (explicit) return explicit;

      if (link.closest('.product-card')) return 'product_card';
      if (link.closest('.shopee-block')) return 'primary_list';
      if (link.classList.contains('inline')) return 'inline';

      var documentHeight = document.documentElement.scrollHeight || 1;
      var ratio = (window.scrollY + link.getBoundingClientRect().top) / documentHeight;
      if (ratio < 0.33) return 'article_top';
      if (ratio > 0.66) return 'article_bottom';
      return 'article_body';
    }

    var experimentId = 'mosquito_monetization_v1';
    var experimentCtas = {
      dintin_picaridin_10h: { merchant: 'coupang', category: 'mosquito_repellent', position: 'decision_primary' },
      collection_vietnam_travel_essentials: { merchant: 'shopee', category: 'travel_essentials', position: 'decision_collection' }
    };

    function isExperimentCta(link) {
      if (window.location.pathname !== '/vietnam-mosquito-repellent' ||
          getTrackingValue(link, 'data-experiment-id') !== experimentId) return false;
      var expected = experimentCtas[getMachineValue(link, 'data-affiliate-product-key', '')];
      return !!expected && getMerchant(link, link.href) === expected.merchant &&
        getAffiliateNetwork(link, link.href) === expected.merchant &&
        getMachineValue(link, 'data-affiliate-category', '') === expected.category &&
        getMachineValue(link, 'data-cta-position', '') === expected.position;
    }

    function getSafeDimensions(link) {
      var pagePath = getPagePath(window.location.pathname);
      return {
        page_path: pagePath,
        page_location: getAnalyticsUrl(window.location.href, false) + pagePath,
        page_referrer: document.referrer ? getAnalyticsUrl(document.referrer, false) : '',
        merchant: getMerchant(link, link.href),
        product_key: getMachineValue(link, 'data-affiliate-product-key', 'unspecified'),
        product_name: getProductName(link),
        product_category: getMachineValue(link, 'data-affiliate-category', 'uncategorized'),
        cta_position: getCtaPosition(link),
        affiliate_network: getAffiliateNetwork(link, link.href)
      };
    }

    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!target || !target.closest) return;

      var link = target.closest(affiliateSelector);
      if (!link || !link.href || typeof window.gtag !== 'function') return;

      var pagePath = getPagePath(window.location.pathname);

      var parameters = Object.assign(getSafeDimensions(link), {
        content_language: document.documentElement.lang || 'unknown',
        brand: ['JOYTEL', 'Klook', 'KKday', 'Airalo', 'eminent', 'BAGSMART'].includes(getTrackingValue(link, 'data-affiliate-brand')) ? getTrackingValue(link, 'data-affiliate-brand') : 'unknown',
        placement: getMachineValue(link, 'data-affiliate-placement', getCtaPosition(link)),
        destination: getMachineValue(link, 'data-affiliate-destination', 'unspecified'),
        article: getPagePath(getTrackingValue(link, 'data-affiliate-article') || pagePath),
        link_url: getAnalyticsUrl(link.href, true),
        link_domain: getAffiliateDomain(link.href),
        category: 'affiliate',
        transport_type: 'beacon'
      });
      if (isExperimentCta(link)) parameters.experiment_id = experimentId;
      window.gtag('event', 'affiliate_click', parameters);
    }, true);

    function observeExperimentCtas() {
      if (window.location.pathname !== '/vietnam-mosquito-repellent' ||
          typeof window.IntersectionObserver !== 'function') return;
      var sent = new Set();
      var states = new Map();
      var observer = new window.IntersectionObserver(function (entries) {
        entries.forEach(updateVisibility);
      }, { threshold: [0, 0.5] });

      function cancel(state) {
        window.clearTimeout(state.timer);
        state.timer = null;
        state.visible = false;
      }

      function updateVisibility(entry) {
        var link = entry.target;
        var state = states.get(link);
        if (!state) return;
        var key = getMachineValue(link, 'data-affiliate-product-key', '');
        if (document.hidden || !entry.isIntersecting || entry.intersectionRatio < 0.5 || sent.has(key)) {
          cancel(state);
          return;
        }
        state.visible = true;
        if (state.timer !== null) return;
        var timer = window.setTimeout(function () {
          // Process queued threshold crossings before counting continuous dwell.
          observer.takeRecords().forEach(updateVisibility);
          if (state.timer !== timer) return;
          state.timer = null;
          if (!state.visible || document.hidden || sent.has(key) || !isExperimentCta(link) ||
              typeof window.gtag !== 'function') return;
          sent.add(key);
          window.gtag('event', 'affiliate_cta_view', Object.assign(getSafeDimensions(link), {
            experiment_id: experimentId,
            transport_type: 'beacon'
          }));
          observer.unobserve(link);
        }, 1000);
        state.timer = timer;
      }

      document.querySelectorAll('a[data-experiment-id="' + experimentId + '"]').forEach(function (link) {
        if (!isExperimentCta(link)) return;
        states.set(link, { timer: null, visible: false });
        observer.observe(link);
      });
      document.addEventListener('visibilitychange', function () {
        states.forEach(function (state, link) {
          cancel(state);
          observer.unobserve(link);
          // A fresh observation after returning requires a new full dwell.
          if (!document.hidden && !sent.has(getMachineValue(link, 'data-affiliate-product-key', ''))) observer.observe(link);
        });
      });
    }

    // SiteNav loads the tracker before article CTA markup has been parsed.
    if (window.location.pathname === '/vietnam-mosquito-repellent') {
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', observeExperimentCtas, { once: true });
      else observeExperimentCtas();
    }
  })();
</script>
