---
interface Props {
  language?: 'zh-TW' | 'en';
  alternateHref?: string;
}

const { language = 'zh-TW', alternateHref } = Astro.props;
const isEnglish = language === 'en';
const languageHref = alternateHref ?? (isEnglish ? '/' : '/en');
const links = isEnglish
  ? [
      { href: '/en', label: 'Home' },
      { href: '/en/vietnam-travel-prep', label: 'Vietnam prep' },
      { href: '/en/travel-gear', label: 'Travel gear' },
      { href: '/en/connectivity', label: 'Connectivity' },
      { href: '/en/about', label: 'About' },
      { href: '/en/contact', label: 'Contact' },
      { href: '/en/privacy', label: 'Privacy' },
      { href: '/en/affiliate-disclosure', label: 'Affiliate disclosure' },
    ]
  : [
      { href: '/', label: '首頁' },
      { href: '/shopping', label: '購物指南' },
      { href: '/esim', label: 'eSIM 比較' },
      { href: '/esim-quiz', label: 'eSIM 測驗' },
      { href: '/japan-guide', label: '日本攻略' },
      { href: '/korea-guide', label: '韓國攻略' },
      { href: '/vietnam-guide', label: '越南攻略' },
      { href: '/thsr-guide', label: '高鐵省錢' },
      { href: '/about', label: '關於' },
      { href: '/contact', label: '聯絡我' },
      { href: '/privacy', label: '隱私權政策' },
    ];
---

<footer class="cbt-footer">
  <strong>{isEnglish ? 'Comeback Traveler' : '重來的旅人'}</strong>
  {isEnglish ? ' · Practical travel planning notes' : ' · 把踩過的坑，變成你的攻略'}
  <nav class="cbt-footer-nav" aria-label={isEnglish ? 'Footer navigation' : '頁尾選單'}>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href={languageHref} lang={isEnglish ? 'zh-TW' : 'en'}>{isEnglish ? '繁中' : 'English'}</a>
  </nav>
  <small class="cbt-footer-copy">
    {isEnglish ? '© 2026 Comeback Traveler · Travel planning and practical guides' : '© 2026 重來的旅人 Comeback Traveler · 越南生活 10 年 · 現在重新出發'}
  </small>
</footer>

<style>
  .cbt-footer {
    --f-ink: #1a1208;
    --f-ink-light: #4a3f2f;
    --f-paper: #faf8f3;
    --f-accent: #c0392b;
    border-top: 2px solid var(--f-ink);
    padding: 40px 24px;
    text-align: center;
    font-size: 13px;
    color: var(--f-ink-light);
    background: var(--f-paper);
    font-family: 'Noto Sans TC', sans-serif;
    line-height: 1.8;
  }
  .cbt-footer strong { color: var(--f-ink); }
  .cbt-footer-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 14px;
  }
  .cbt-footer-nav a {
    color: var(--f-accent);
    text-decoration: none;
    font-size: 13px;
  }
  .cbt-footer-nav a:hover { text-decoration: underline; }
  .cbt-footer-copy {
    display: block;
    margin-top: 16px;
    font-size: 12px;
    color: var(--f-ink-light);
  }
</style>
