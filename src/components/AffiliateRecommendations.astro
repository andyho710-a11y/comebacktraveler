---
export interface AffiliateOffer {
  brand: string;
  productName: string;
  affiliateUrl?: string;
  network?: string;
  ctaLabel: string;
}

export interface Recommendation {
  title: string;
  description: string;
  detail: string;
  destination: string;
  category: string;
  offers: AffiliateOffer[];
  fallback: { href: string; label: string };
}

interface Props {
  id: string;
  heading: string;
  intro: string;
  article: string;
  placement: string;
  recommendations: Recommendation[];
  priceNote?: string;
}

const { id, heading, intro, article, placement, recommendations,
  priceNote = '價格與方案以官方頁面為準；付款前再確認手機相容性、使用天數、涵蓋國家與熱點限制。',
} = Astro.props;
// Missing partner URLs use real internal guidance links, never empty/# purchase CTAs.
for (const item of recommendations) {
  for (const offer of item.offers) {
    if (offer.affiliateUrl && new URL(offer.affiliateUrl).protocol !== 'https:') {
      throw new Error(`Affiliate URL must use HTTPS: ${offer.brand}`);
    }
  }
  if (!item.offers.some((offer) => offer.affiliateUrl) && !/^(\/(?!\/)|#[\w-]+)/.test(item.fallback.href)) {
    throw new Error(`Missing internal fallback: ${item.title}`);
  }
}
---

<section class="recommendations" aria-labelledby={`${id}-heading`} id={id}>
  <h2 id={`${id}-heading`}>{heading}</h2>
  <p class="intro">{intro}</p>
  <ul class="recommendation-list">
    {recommendations.map((item) => (
      <li class="recommendation-card">
        <div class="recommendation-copy">
          <h3>{item.title}</h3>
          <p class="description">{item.description}</p>
          <p class="detail">{item.detail}</p>
        </div>
        <div class="recommendation-actions">
        {item.offers.some((offer) => offer.affiliateUrl) ? item.offers.filter((offer) => offer.affiliateUrl).map((offer) => (
          <a
            class="recommendation-cta"
            href={offer.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
            data-affiliate={offer.network || 'affiliate'}
            data-affiliate-brand={offer.brand}
            data-affiliate-product={offer.productName}
            data-affiliate-category={item.category}
            data-cta-position={placement}
            data-affiliate-placement={placement}
            data-affiliate-destination={item.destination}
            data-affiliate-article={article}
          >
            <span>{offer.ctaLabel}<span aria-hidden="true"> →</span></span>
            <span class="new-tab">（另開分頁）</span>
          </a>
        )) : (
          <a class="recommendation-cta guidance" href={item.fallback.href}>
            {item.fallback.label}<span aria-hidden="true"> →</span>
          </a>
        )}
        </div>
      </li>
    ))}
  </ul>
  <p class="price-note">{priceNote}</p>
</section>

<style>
  .recommendations {
    margin: 28px 0 36px;
    padding: 20px 16px;
    border: 1.5px solid var(--border, #d4c9b0);
    border-radius: 8px;
    background: var(--paper-warm, #f2ede0);
    color: var(--ink, #1a1208);
    font-family: var(--sans, 'Noto Sans TC', sans-serif);
    scroll-margin-top: 96px;
  }
  h2 { margin: 0 0 8px; font-family: var(--serif, serif); font-size: 23px; line-height: 1.45; }
  .intro { margin: 0 0 16px; font-size: 15px; line-height: 1.7; }
  .recommendation-list { display: grid; gap: 12px; padding: 0; margin: 0; list-style: none; }
  .recommendation-card {
    display: grid;
    gap: 14px;
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--border, #d4c9b0);
    border-radius: 6px;
    background: var(--paper, #faf8f3);
    overflow-wrap: anywhere;
  }
  h3 { margin: 0 0 6px; font-family: var(--serif, serif); font-size: 19px; line-height: 1.5; }
  .description { margin: 0; font-size: 15px; line-height: 1.7; }
  .detail, .price-note { color: var(--ink-light, #4a3f2f); font-size: 13px; line-height: 1.7; }
  .detail { margin: 6px 0 0; }
  .price-note { margin: 14px 0 0; }
  .recommendation-actions { display: grid; gap: 12px; min-width: 0; }
  .recommendation-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 16px;
    border: 2px solid transparent;
    border-radius: 4px;
    background: var(--accent, #c0392b);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
  }
  .recommendation-cta:hover { background: #a93226; text-decoration: underline; }
  .recommendation-cta:focus-visible { outline: 3px solid var(--ink, #1a1208); outline-offset: 4px; }
  .new-tab { font-size: 12px; font-weight: 400; }
  .guidance { background: var(--ink, #1a1208); }
  .guidance:hover { background: #4a3f2f; }
  @media (min-width: 700px) {
    .recommendations { padding: 24px; }
    .recommendation-card { grid-template-columns: minmax(0, 1fr) 220px; align-items: center; gap: 20px; }
  }
</style>
