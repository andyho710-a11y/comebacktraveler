---
import type { Recommendation } from './AffiliateRecommendations.astro';
import { packingPriceNote } from '../data/first-trip-packing-recommendations';

interface Props {
  id: string;
  heading: string;
  intro: string;
  article: string;
  placement: string;
  recommendation: Recommendation;
}
const { id, heading, intro, article, placement, recommendation: item } = Astro.props;
// Packing-only presentation keeps the observed eSIM component and CSS bundle unchanged.
for (const offer of item.offers) {
  if (!offer.affiliateUrl || new URL(offer.affiliateUrl).protocol !== 'https:') {
    throw new Error(`Packing recommendation requires an HTTPS affiliate URL: ${offer.brand}`);
  }
}
---

<section class="recommendations" aria-labelledby={`${id}-heading`} id={id}>
  <h2 id={`${id}-heading`}>{heading}</h2>
  <p class="intro">{intro}</p>
  <ul class="recommendation-list">
    <li class="recommendation-card">
      <div class="recommendation-copy">
        <h3>{item.title}</h3>
        <p class="description">{item.description}</p>
        <p class="detail">{item.detail}</p>
      </div>
      <div class="recommendation-actions">
        {item.offers.map((offer) => (
          <a class="recommendation-cta" href={offer.affiliateUrl}
            target="_blank" rel="sponsored noopener noreferrer"
            data-affiliate={offer.network}
            data-affiliate-brand={offer.brand}
            data-affiliate-product={offer.productName}
            data-affiliate-category={item.category}
            data-cta-position={placement}
            data-affiliate-placement={placement}
            data-affiliate-destination={item.destination}
            data-affiliate-article={article}>
            <span>{offer.ctaLabel}<span aria-hidden="true"> →</span></span>
            <span class="new-tab">（另開分頁）</span>
          </a>
        ))}
      </div>
    </li>
  </ul>
  <p class="price-note">{packingPriceNote}</p>
</section>

<style>
  .recommendations { margin: 28px 0 36px; padding: 20px 16px; border: 1.5px solid var(--border); border-radius: 8px; background: var(--paper-warm); color: var(--ink); font-family: var(--sans); scroll-margin-top: 96px; }
  h2 { margin: 0 0 8px; font-family: var(--serif); font-size: 23px; line-height: 1.45; }
  .intro { margin: 0 0 16px; font-size: 15px; line-height: 1.7; }
  .recommendation-list { display: grid; gap: 12px; padding: 0; margin: 0; list-style: none; }
  .recommendation-card { display: grid; gap: 14px; min-width: 0; padding: 16px; border: 1px solid var(--border); border-radius: 6px; background: var(--paper); overflow-wrap: anywhere; }
  h3 { margin: 0 0 6px; font-family: var(--serif); font-size: 19px; line-height: 1.5; }
  .description { margin: 0; font-size: 15px; line-height: 1.7; }
  .detail, .price-note { color: var(--ink-light); font-size: 13px; line-height: 1.7; }
  .detail { margin: 6px 0 0; }
  .price-note { margin: 14px 0 0; }
  .recommendation-actions { display: grid; gap: 12px; min-width: 0; }
  .recommendation-cta { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 48px; padding: 12px 16px; border: 2px solid transparent; border-radius: 4px; background: var(--accent); color: #fff; font-size: 15px; font-weight: 600; line-height: 1.5; text-align: center; text-decoration: none; }
  .recommendation-cta:hover { background: #a93226; text-decoration: underline; }
  .recommendation-cta:focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; }
  .new-tab { font-size: 12px; font-weight: 400; }
  @media (min-width: 700px) { .recommendations { padding: 24px; } .recommendation-card { grid-template-columns: minmax(0, 1fr) 220px; align-items: center; gap: 20px; } }
</style>
