---
import '../styles/global.css';
const { title = '高雄好幫手｜清潔・小修繕免費媒合', description = '把家裡的小事，交給附近的好幫手。高雄清潔與小修繕免費媒合，需求與服務者人工審核。' } = Astro.props;
const pilot = import.meta.env.PUBLIC_PILOT_ENABLED === 'true';
const staging = import.meta.env.PUBLIC_ENVIRONMENT === 'staging';
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} /><meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#174c3c" /><title>{title}</title>
    <link rel="icon" href="/services/favicon.svg" type="image/svg+xml" />
  </head>
  <body data-services="true">
    <a class="skip" href="#main">跳到內容</a>
    <div class="services-parent"><a href="/">← Comeback Traveler 旅遊網站</a><span>生活服務專區</span></div>
    <div class="pilot-bar">{staging ? '測試環境 · 不接受正式委託' : pilot ? '免費試營運' : '測試預覽 · 尚未開放刊登'}<span>不抽成 · 不代收款 · 雙方自行結算</span></div>
    <header class="header"><a class="brand" href="/services"><span class="brand-mark" aria-hidden="true">好</span>高雄好幫手<span class="brand-sub">把生活的小事，照顧好</span></a>
      <nav aria-label="主要導覽"><a href="/services/jobs">找案件</a><a href="/services/provider">成為好幫手</a><a href="/services/dashboard">我的案件</a><a href="/services/notifications">通知</a><a class="nav-account" href="/services/account">登入／註冊</a></nav>
    </header>
    <main id="main"><div id="notice" class="notice" role="status" aria-live="polite" hidden></div><slot /></main>
    <footer><div><a class="brand" href="/services">高雄好幫手</a><p>讓附近的需求，遇見合適的人。</p></div><div><a href="/services/privacy">個資告知與服務約定</a><a href="/services/admin">管理者審核</a><p>平台免費提供資訊媒合；服務內容、價格與付款由雙方確認。</p></div></footer>
    <script>
      import {client} from '../lib/client';
      client?.auth.onAuthStateChange((_event,session) => { const link=document.querySelector('.nav-account'); if(link && session) { link.textContent='會員帳號'; } });
    </script>
  </body>
</html>
