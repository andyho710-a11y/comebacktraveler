---
import ReadingThemeHead from '../../../components/ReadingThemeHead.astro';
import ReadingThemeControl from '../../../components/ReadingThemeControl.astro';
import '../styles/transfer.css';
const { title = '高雄安心包車長途接送｜楠梓出發・一般陪診', description = 'Toyota Corolla Cross Hybrid 油電車，楠梓、左營、橋頭、岡山出發。提供包車、長途接送與一般陪診，費用與服務範圍提前確認。', privacy = false } = Astro.props;
const canonical = `https://comebacktraveler.com/services${privacy ? '/privacy' : ''}`;
---
<!doctype html>
<html lang="zh-TW"><head><meta charset="UTF-8" />
<ReadingThemeHead />
<meta name="viewport" content="width=device-width,initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><meta name="robots" content={privacy ? 'noindex,nofollow' : 'index,follow'} /><link rel="canonical" href={canonical} /><link rel="icon" href="/services/favicon.svg" type="image/svg+xml" /><meta name="theme-color" content="#315d46" /><meta property="og:type" content="website" /><meta property="og:locale" content="zh_TW" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://comebacktraveler.com/services/photos/vehicle-exterior-1440.webp" /></head>
<body data-services="true" data-service-mode="personal-transfer"><a class="skip" href="#main">跳至主要內容</a><div class="parent"><a href="/">← 重來的旅人</a><span>個人預約服務・費用提前確認</span></div><header class="wrap header"><a class="brand" href="/services"><span class="brand-mark" aria-hidden="true">↗</span><span>高雄安心<span class="brand-small">包車・長途接送・一般陪診</span></span></a><ReadingThemeControl /><nav aria-label="服務導覽"><a href="/services#prices">包車費率</a><a href="/services#companion">一般陪診</a><a href="/services#contact">聯絡詢問</a></nav></header><slot /><footer class="wrap footer"><div><strong>高雄安心長途接送</strong><p>出門有人接，回程也有人等。</p></div><div><a href="/services/privacy">隱私與服務說明</a><p>實際計價與預約依現有車隊規範確認。詢問不等於預約成立。</p></div></footer></body></html>
