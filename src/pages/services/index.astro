---
import TransferLayout from '../../features/services/layouts/TransferLayout.astro';
import pricing from '../../features/services/data/transfer-pricing.json';
const fallback = 'https://kaohsiung-safe-transfer.web.app/#inquiry';
const configuredLine = import.meta.env.TRANSFER_LINE_URL || '';
const lineUrl = /^https:\/\/(?:line\.me|lin\.ee)\//.test(configuredLine) ? configuredLine : fallback;
const lineId = /^[A-Za-z0-9._-]{1,50}$/.test(import.meta.env.TRANSFER_LINE_ID || '') ? import.meta.env.TRANSFER_LINE_ID : '';
const money = (n: number) => n.toLocaleString('en-US');
const faq = [
 ['包車基本價包含哪些費用？','包含車輛、駕駛、油資與方案內時數及里程；停車、過路及其他代墊費另列。行車與停留都算用車時間，超時會增加對應里程額度，再計算是否超里程。'],
 ['一般陪診與醫院接送，是同一個費用嗎？','不是。一般陪診至少 2 小時 $800，協助掛號、候診、繳費與領藥；交通依上、下車地點另報。院內陪同與交通分列，與包車搭配時先確認組合總價，不直接疊加兩套時薪。'],
 ['可以搭幾位乘客、放多少行李？','Toyota Corolla Cross Hybrid 為 5 人座含駕駛，最多 4 位乘客。安全座椅、行李與大型物品都需提前提供尺寸，依實際配置確認。'],
 ['可以到台南、屏東、機場或高鐵嗎？','可以提供需求詢問。點對點接送依上、下車地點、里程、是否往返與等候個別報價；跨縣市與特殊路線不直接套用市區包車基本價。'],
 ['試營運優惠之後會調整嗎？','目前先以試營運優惠接受行程詢問。未來若有調整，會更新價目，並於每次預約前說明確認；本頁不會自動成立報價或預約。'],
 ['如何確認預約成立？','先提供日期、地區、乘客、行李、停靠點與預計時間。駕駛確認檔期、路線、費用及車隊預約流程後，才完成正式預約；點擊 LINE 或傳訊息都不會自動成立。'],
];
const schema = { '@context':'https://schema.org', '@type':'Service', name:'高雄安心包車長途接送', serviceType:['包車','長途接送','一般陪診'], url:'https://comebacktraveler.com/services', description:'楠梓出發的個人行程服務；一般陪診不含醫療照護或移位。', areaServed:['高雄市楠梓區','高雄市左營區','高雄市橋頭區','高雄市岡山區'], provider:{'@type':'Organization',name:'高雄安心長途接送',url:'https://comebacktraveler.com/services'}, offers:pricing.packages.map(p=>({'@type':'Offer',name:`${p.hours} 小時／${p.km} 公里參考方案`,price:p.price,priceCurrency:'TWD',url:'https://comebacktraveler.com/services#prices',description:'起價，限平日日間與指定出發及結束區域；停車、過路及超額費用另列，須人工確認。'})) };
---
<TransferLayout><main id="main">
<section class="wrap hero"><div><p class="eyebrow">從高雄出發，把回程也安排好</p><h1>安心包車，<br />長途接送有人等。</h1><p class="lead">家庭出遊、跨縣市往返、醫院接送與一般陪診。<br />由同一位駕駛親自討論，先確認路線，再安排這一趟。</p><div class="actions"><a class="button" href={lineUrl} target="_blank" rel="noreferrer">LINE 詢問行程 ↗</a><a href="#prices">查看服務報價 ↓</a></div><p class="small">楠梓・左營・橋頭・岡山出發｜費用提前確認</p></div><figure class="vehicle"><img src="/services/photos/vehicle-exterior-1440.webp" srcset="/services/photos/vehicle-exterior-720.webp 720w, /services/photos/vehicle-exterior-1440.webp 1440w" sizes="(max-width:800px) calc(100vw - 36px), 520px" width="1440" height="1084" fetchpriority="high" alt="車主的白色 Toyota Corolla Cross Hybrid，車牌與個資已遮蔽" /><figcaption><strong>Toyota Corolla Cross Hybrid</strong><span>油電車・5 人座含駕駛，最多 4 位乘客</span></figcaption></figure></section>
<section id="prices" class="tint section"><div class="wrap"><div class="heading"><div><p class="eyebrow">先看清楚，再放心安排</p><h2>包車試營運優惠</h2></div><p>平日日間指定區域方案，包含車輛、駕駛與油資。<br />停車、過路與超額費用另列。</p></div><div class="price-grid">{pricing.packages.map(p=><article class:list={['price-card',{'featured':p.hours===8}]}><span class="badge">{pricing.marketing.label}・{p.label}</span><h3>{p.hours} 小時／{p.km} 公里</h3><p class="price">${money(p.price)} <small>起</small></p><p class="small">包含車輛、駕駛與油資；平日日間指定區域適用。</p></article>)}</div><p class="reference-note">更新日期：{pricing.updated}。{pricing.marketing.note} 適用區域、超時、超里程及代墊費用請見下方方案條件。</p></div></section>
<section id="companion" class="wrap section two-col"><div><p class="eyebrow">把院內協助與交通分開說清楚</p><h2>一般陪診<br />2 小時 $800 起</h2><p>每小時 $400，至少 2 小時。可協助掛號、候診、繳費及領藥；院內會合起至交接完成計時，交通費另外報價。</p><p>不含醫療照護、搬抱移位、專業病情解讀或長照特約服務。若有特殊照護需求，請先與合適的專業單位確認。</p><a class="button" href={lineUrl} target="_blank" rel="noreferrer">詢問陪診與接送需求 ↗</a></div><aside class="box"><h3>接送、等候與陪診，各自確認</h3><ul><li><strong>醫院接送：</strong>依上下車地點、往返及等候需求報價。</li><li><strong>一般陪診：</strong>院內人力工時，交通與醫療代墊費另列。</li><li><strong>一起安排：</strong>先確認組合總價，不直接疊加兩套時薪。</li><li><strong>長途／機場／高鐵：</strong>依路線個別報價。</li></ul><p class="small">初次聯繫提供日期與地區即可，請勿傳送身分證、病歷或其他敏感資料。</p></aside></section>
<section class="tint section"><div class="wrap"><p class="eyebrow">預約前，一起確認</p><h2>加價與方案條件</h2><ol class="rules">{pricing.conditions.map(rule=><li>{rule}</li>)}</ol></div></section>
<section class="wrap section"><div class="heading"><div><p class="eyebrow">先看看實際乘車空間</p><h2>後座與行李廂</h2></div><p class="small">車主提供照片，已遮蔽證件與車牌。</p></div><div class="gallery"><figure><img src="/services/photos/vehicle-rear-seat-720.webp" width="720" height="542" loading="lazy" decoding="async" alt="車輛後座座椅，前座背面證件已遮蔽" /><figcaption><h3>乘坐空間</h3><p>最多 4 位乘客，兒童安全座椅與實際配置須事先確認。</p></figcaption></figure><figure><img src="/services/photos/vehicle-luggage-720.webp" width="720" height="542" loading="lazy" decoding="async" alt="後座直立時的行李廂，遠處證件與車牌已遮蔽" /><figcaption><h3>行李空間</h3><p>請提供件數與長寬高，嬰兒車、大型物品也請先說明。</p></figcaption></figure></div></section>
<section id="contact" class="wrap section"><div class="contact"><div><p class="eyebrow" style="color:#e2e9df">提前詢問，一對一安排</p><h2>這趟路，你想怎麼安排？</h2><p>日期・出發地區・目的地・人數・行李・預計時間</p>{lineId&&<strong>LINE ID：{lineId}</strong>}<p class="small">個人 LINE 人工聯繫。請先確認收件人，詢問不等於預約成立。</p></div><a class="button" href={lineUrl} target="_blank" rel="noreferrer">用 LINE 聊聊行程 ↗</a></div></section>
<section class="wrap section faq"><div><p class="eyebrow">出發前先了解</p><h2>常見問題</h2></div><div>{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
</main><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')} /></TransferLayout>
