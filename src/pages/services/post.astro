---
import Layout from '../../features/services/layouts/Layout.astro';
import { categories,districts,excluded } from '../../features/services/lib/catalog';
---
<Layout title="免費刊登需求｜高雄好幫手"><div class="narrow"><div class="page-head"><div class="eyebrow">POST A REQUEST · FREE</div><h1>說說你需要的幫忙。</h1><p>不必先決定找誰。留下需求、時間與預算，審核後讓附近合適的服務者報價。</p></div><div class="info">請先<a href="/services/account">登入並完成會員資料</a>。刊登免費、不抽成；價格與付款由雙方自行確認。{excluded}</div>
 <form id="job-form" class="form-card"><h2>案件需求</h2><div class="form-grid"><div class="field"><label for="category">服務類別</label><select id="category" required>{Object.entries(categories).map(([key,name])=><option value={key}>{name}</option>)}</select></div><div class="field"><label for="district">高雄行政區</label><select id="district" required>{districts.map(d=><option>{d}</option>)}</select></div></div><div class="field"><label for="time">希望服務的日期與時間</label><input id="time" type="datetime-local" required /><p class="hint">台灣時間，未來 180 天內。實際時間由雙方再確認。</p></div><div class="form-grid"><div class="field"><label for="budget-min">最低預算（NT$）</label><input id="budget-min" type="number" min="0" max="100000" step="1" value="1000" required /></div><div class="field"><label for="budget-max">最高預算（NT$）</label><input id="budget-max" type="number" min="1" max="100000" step="1" value="3000" required /></div></div><div class="field"><label for="summary">需求描述（審核後給合適的服務者查看）</label><textarea id="summary" minlength="10" maxlength="1000" required placeholder="例如：兩房一廳的一般打掃，約 20 坪，希望清潔廚房、浴室與地板。家中有一隻貓。"></textarea><p class="hint">不要填入姓名、電話、社群帳號、完整地址或門牌。管理者會人工確認需求與安全範圍。</p></div><button type="button" class="button secondary small" id="organize">協助整理填寫重點</button><p class="hint">只在你的裝置上整理欄位提示，不傳給外部 AI；最後由你確認、管理者審核。</p><hr/><h2>私人聯絡資料</h2><p class="hint">限本人與必要審核管理員查看。你明確同意分享、選定服務者且對方確認接單後，才分享電話與施工地址；不向服務者提供客戶姓名。案件列表只顯示行政區。</p><div class="field"><label for="address">完整服務地址（不公開）</label><input id="address" minlength="5" maxlength="200" autocomplete="street-address" required /></div><div class="form-grid"><div class="field"><label for="contact">聯絡人（不公開）</label><input id="contact" minlength="2" maxlength="40" autocomplete="name" required /></div><div class="field"><label for="contact-phone">聯絡電話（不公開）</label><input id="contact-phone" type="tel" pattern="[0-9+() -]{8,24}" autocomplete="tel" required /></div></div><div class="field"><label for="photos">需求照片（選填，最多 5 張）</label><input id="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple /><p class="hint">避開人臉、證件、門牌及貴重物品。照片預設僅本人與必要審核管理員可看。刊登後可逐張同意報價或接單階段分享，仍須通過管理員安全審核。影像會移除定位等中繼資料，但不會自動遮蔽畫面中的個資，請先自行遮蔽。每張原始檔最多 8 MB。</p></div><label class="consent"><input id="match-consent" type="checkbox" required /><span>我明確同意：本案選定的服務者確認接單後，可在服務期間取得必要聯絡電話與完整施工地址；客戶姓名不分享。照片另行授權。取消、結案或撤回後停止新的存取，已看過或下載的資料無法遠端收回。</span></label><label class="consent"><input id="consent" type="checkbox" required /><span>我已閱讀<a href="/services/privacy">個資告知與服務約定</a>，同意必要資料用於媒合及安排服務，確認需求不涉及高風險或需證照的工程。</span></label><button class="button" id="submit" type="submit">免費送出，等待人工審核</button></form></div>
 <script>
 import { client,run,message,check,session,preparePhoto } from '../../features/services/lib/client';
 const input=(id:string)=>(document.getElementById(id) as HTMLInputElement).value;
 const form=document.getElementById('job-form') as HTMLFormElement;
 const category=document.getElementById('category') as HTMLSelectElement;
 const preset=new URLSearchParams(location.search).get('category'); if(preset&&[...category.options].some(o=>o.value===preset))category.value=preset;
 const now=new Date();const taiwan = new Date(now.getTime()+8*3600000);(document.getElementById('time') as HTMLInputElement).min=taiwan.toISOString().slice(0,16);
 document.getElementById('organize')!.addEventListener('click',()=>{const box=document.getElementById('summary') as HTMLTextAreaElement;if(!box.value.trim())box.value='服務範圍：\n空間大小／數量：\n希望完成的項目：\n需要自備的工具／清潔用品：\n其他注意事項（寵物、停車等）：';message('已提供填寫重點，請補上實際需求。此內容仍需人工審核。');});
 let createdId:string|null=null;
 form.addEventListener('submit',e=>{e.preventDefault();void run(async()=>{
  if(createdId) { location.href='/services/job?id='+encodeURIComponent(createdId);return; }
  const user=await session();const {data:profile}=check(await client!.from('profiles').select('id').eq('id',user.id).maybeSingle());if(!profile)throw new Error('請先到會員帳號儲存姓名、電話並同意個資告知。');
  const files=[...(document.getElementById('photos') as HTMLInputElement).files??[]];if(files.length>5)throw new Error('每個案件最多 5 張照片。');
  const blobs=await Promise.all(files.map(preparePhoto));
  if(+input('budget-min')>+input('budget-max'))throw new Error('最低預算不能大於最高預算。');
  const {data:id}=check(await client!.rpc('create_job',{p_category:input('category'),p_district:input('district'),p_time:new Date(input('time')+':00+08:00').toISOString(),p_min:+input('budget-min'),p_max:+input('budget-max'),p_summary:input('summary'),p_address:input('address'),p_contact:input('contact'),p_phone:input('contact-phone'),p_consent:(document.getElementById('consent') as HTMLInputElement).checked}));
  createdId=id;check(await client!.rpc('consent_match_sharing',{p_job:id,p_consent:(document.getElementById('match-consent') as HTMLInputElement).checked}));let failed=0;
  for(const blob of blobs){const {error}=await client!.storage.from('job-photos').upload(`${user.id}/${id}/${crypto.randomUUID()}.jpg`,blob,{contentType:'image/jpeg',cacheControl:'0',upsert:false});if(error)failed++;}
  form.reset();message(failed?`案件已儲存並等待審核，但 ${failed} 張照片未上傳成功。請到案件頁補傳；不要再次刊登。`:'案件與照片已儲存，等待管理者審核。');
  const link=document.createElement('a');link.className='button';link.href='/services/job?id='+encodeURIComponent(id);link.textContent='查看已刊登的案件';form.replaceChildren(link);
 });});
 </script></Layout>
