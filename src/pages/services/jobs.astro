---
import Layout from '../../features/services/layouts/Layout.astro';
import {categories,districts} from '../../features/services/lib/catalog';
---
<Layout title="查看合適案件｜高雄好幫手"><div class="page-head"><div class="eyebrow">LOCAL REQUESTS</div><h1>附近，正好需要你的幫忙。</h1><p>只有通過審核的服務者能查看符合服務類別與地區的案件；完整地址、電話與照片不出現在列表。</p></div><div class="info">新加入的服務者請先<a href="/services/provider">申請並等待審核</a>。若你是客戶，請到<a href="/services/dashboard">我的案件</a>比較收到的報價。</div><form id="filters" class="form-grid"><div class="field"><label for="category">類別</label><select id="category"><option value="">全部符合的類別</option>{Object.entries(categories).map(([key,name])=><option value={key}>{name}</option>)}</select></div><div class="field"><label for="district">行政區</label><select id="district"><option value="">全部符合的行政區</option>{districts.map(d=><option>{d}</option>)}</select></div></form><div id="jobs" class="job-list"><div class="empty">登入並通過服務者審核後，這裡會顯示合適的真實案件。</div></div><button id="more" class="button secondary" hidden style="margin-top:20px">載入更多</button><script>
 import {client,enabled,run,check,session} from '../../features/services/lib/client';import {jobCard,type Job} from '../../features/services/lib/jobs';
 const box=document.getElementById('jobs')!;let offset=0;
 async function load(append=false){await session();if(!append)offset=0;let query=client!.from('jobs').select('*').eq('status','open').order('created_at',{ascending:false}).range(offset,offset+19);const cat=(document.getElementById('category') as HTMLSelectElement).value;const area=(document.getElementById('district') as HTMLSelectElement).value;if(cat)query=query.eq('category',cat);if(area)query=query.eq('district',area);const {data}=check(await query);const html=(data as Job[]).map(jobCard).join('');if(append)box.insertAdjacentHTML('beforeend',html);else box.innerHTML=html||'<div class="empty">目前沒有符合的案件。若尚未核准，請先完成服務者申請。</div>';offset+=data!.length;document.getElementById('more')!.hidden=data!.length<20;}
 document.getElementById('filters')!.addEventListener('change',()=>void run(()=>load()));document.getElementById('more')!.addEventListener('click',()=>void run(()=>load(true)));if(enabled)void run(()=>load());
 </script></Layout>
