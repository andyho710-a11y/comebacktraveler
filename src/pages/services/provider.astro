---
import Layout from '../../features/services/layouts/Layout.astro';
import { categories,districts,excluded } from '../../features/services/lib/catalog';
---
<Layout title="申請成為好幫手｜高雄好幫手"><div class="narrow"><div class="page-head"><div class="eyebrow">BECOME A LOCAL HELPER</div><h1>把你的手藝，<br/>變成附近的好幫忙。</h1><p>自由選擇服務類別與地區，核准後查看合適案件。試營運期間免費加入、不抽成。</p></div><div class="info">請先<a href="/services/account">登入並儲存會員資料</a>。管理者審核申請後才開放報價；核准不代表專業證照或服務保證。{excluded}</div><div id="application-status" class="notice" hidden></div><form id="provider-form" class="form-card"><div class="field"><label for="real-name">真實姓名（僅管理者查看）</label><input id="real-name" minlength="2" maxlength="40" autocomplete="name" required /></div><fieldset><legend>可提供的服務（可複選）</legend><div class="check-grid">{Object.entries(categories).map(([id,name])=><label><input type="checkbox" name="category" value={id}/>{name}</label>)}</div></fieldset><fieldset><legend>可服務的高雄行政區（可複選）</legend><div class="check-grid">{districts.map(d=><label><input type="checkbox" name="district" value={d}/>{d}</label>)}</div></fieldset><div class="field"><label for="intro">服務經驗與介紹</label><textarea id="intro" minlength="10" maxlength="1000" required placeholder="請介紹可提供的服務、經驗、工具及時間。不要填入證件號碼。"></textarea><p class="hint">管理者會確認並整理公開稱呼與簡介，不公開真實姓名、電話或證件。</p></div><label class="consent"><input id="consent" type="checkbox" required /><span>我已閱讀<a href="/services/privacy">個資告知與服務約定</a>，確認僅提供允許範圍內的服務，報價與收款由我和客戶自行確認。</span></label><button class="button" type="submit">免費申請，等待審核</button></form></div><script>
 import {client,enabled,run,message,check,session} from '../../features/services/lib/client';import {statuses} from '../../features/services/lib/catalog';
 const form=document.getElementById('provider-form') as HTMLFormElement;
 async function load(){const user=await session();const {data}=check(await client!.from('provider_applications').select('*').eq('user_id',user.id).maybeSingle());if(data){const box=document.getElementById('application-status')!;box.hidden=false;box.textContent=`申請狀態：${statuses[data.status]}。${data.review_note||''}`;if(['approved','suspended'].includes(data.status))form.hidden=true;}}
 form.addEventListener('submit',e=>{e.preventDefault();void run(async()=>{await session();const selected=(name:string)=>[...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map(e=>e.value);if(!selected('category').length||!selected('district').length)throw new Error('請至少勾選一個服務類別與行政區。');check(await client!.rpc('apply_provider',{p_name:(document.getElementById('real-name') as HTMLInputElement).value,p_categories:selected('category'),p_districts:selected('district'),p_intro:(document.getElementById('intro') as HTMLTextAreaElement).value,p_consent:(document.getElementById('consent') as HTMLInputElement).checked}));message('申請已儲存，等待管理者審核。');await load();});});if(enabled)void load().catch(()=>message('請先登入並完成會員資料後再申請。',true));
 </script></Layout>
