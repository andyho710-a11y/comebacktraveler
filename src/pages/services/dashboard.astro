---
import Layout from '../../features/services/layouts/Layout.astro';
---
<Layout title="我的案件｜高雄好幫手"><div class="page-head"><div class="eyebrow">MY REQUESTS & WORK</div><h1>每一件小事，都有進度。</h1><p>查看你的刊登、報價與已承接案件。核准與完成狀態會記錄在這裡。</p></div><div class="tabs"><a class="button" href="/services/post">免費刊登</a><a class="button secondary" href="/services/jobs">查看合適案件</a></div><section class="section"><h2>我刊登的需求</h2><div id="owned" class="job-list"><div class="empty">請先登入查看自己的案件。</div></div></section><section class="section"><h2>我承接的案件</h2><div id="assigned" class="job-list"></div></section><section class="section"><h2>我送出的報價</h2><div id="quotes" class="job-list"></div></section><script>
 import {client,enabled,run,check,session,escape} from '../../features/services/lib/client';import {jobCard,money,type Job} from '../../features/services/lib/jobs';import {statuses} from '../../features/services/lib/catalog';
 if(enabled)void run(async()=>{const user=await session();const owned=check(await client!.from('jobs').select('*').eq('owner_id',user.id).order('created_at',{ascending:false}).limit(100));document.getElementById('owned')!.innerHTML=(owned.data as Job[]).map(jobCard).join('')||'<div class="empty">你還沒有刊登需求。先說說家裡需要哪種幫忙。</div>';const assigned=check(await client!.from('jobs').select('*').eq('selected_provider_id',user.id).order('created_at',{ascending:false}).limit(100));document.getElementById('assigned')!.innerHTML=(assigned.data as Job[]).map(jobCard).join('')||'<div class="empty">目前沒有承接的案件。</div>';const quotes=check(await client!.from('quotes').select('*').eq('provider_id',user.id).order('created_at',{ascending:false}).limit(100));document.getElementById('quotes')!.innerHTML=quotes.data!.map(q=>`<article class="job-card"><span class="tag">${escape(statuses[q.status])}</span><p class="budget">${money(q.amount)}</p><p>${escape(q.note)}</p><a class="button secondary small" href="/services/job?id=${encodeURIComponent(q.job_id)}">查看案件（須仍有權限）</a></article>`).join('')||'<div class="empty">尚未送出報價。</div>';});
 </script></Layout>
